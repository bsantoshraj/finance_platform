# main-backend/routes/income.py
from flask import Blueprint, jsonify, request
from storage.income import (
    get_all_income,
    get_income_by_id,
    add_income,
    update_income,
    delete_income
)
from storage.resources import initialize_db
from utils.auth import token_required

bp = Blueprint('income', __name__, url_prefix='/api/income')

@bp.route('', methods=['GET'])
@token_required
def get_income():
    """
    Get all income entries for the user.
    
    Returns:
        JSON: A list of income entries.
    """
    initialize_db(request.user_id)
    income = get_all_income(request.user_id)
    return jsonify(income), 200

@bp.route('/<int:id>', methods=['GET'])
@token_required
def get_single_income(id):
    """
    Get a specific income entry by its ID.
    
    Args:
        id (int): The ID of the income entry.
    
    Returns:
        JSON: The income details, or an error if not found.
    """
    initialize_db(request.user_id)
    income = get_income_by_id(request.user_id, id)
    if income:
        return jsonify(income), 200
    return jsonify({'error': 'Income not found'}), 404

@bp.route('', methods=['POST'])
@token_required
def create_income():
    """
    Create a new income entry for the user.
    
    Body:
        JSON: Income data (amount, source, date, etc.).
    
    Returns:
        JSON: The created income entry, or an error if invalid.
    """
    initialize_db(request.user_id)
    data = request.get_json()
    if not data:
        return jsonify({'error': 'No data provided'}), 400
    try:
        income = add_income(request.user_id, data)
        return jsonify(income), 201
    except ValueError as e:
        return jsonify({'error': str(e)}), 400

@bp.route('/<int:id>', methods=['PUT'])
@token_required
def update_income_route(id):
    """
    Update an existing income entry.
    
    Args:
        id (int): The ID of the income entry.
    
    Body:
        JSON: Updated income data.
    
    Returns:
        JSON: The updated income entry, or an error if not found.
    """
    initialize_db(request.user_id)
    data = request.get_json()
    if not data:
        return jsonify({'error': 'No data provided'}), 400
    try:
        income = update_income(request.user_id, id, data)
        if income:
            return jsonify(income), 200
        return jsonify({'error': 'Income not found'}), 404
    except ValueError as e:
        return jsonify({'error': str(e)}), 400

@bp.route('/<int:id>', methods=['DELETE'])
@token_required
def delete_income_route(id):
    """
    Delete an income entry.
    
    Args:
        id (int): The ID of the income entry.
    
    Returns:
        JSON: Success message, or an error if not found.
    """
    initialize_db(request.user_id)
    if delete_income(request.user_id, id):
        return jsonify({'message': 'Income deleted'}), 200
    return jsonify({'error': 'Income not found'}), 404


