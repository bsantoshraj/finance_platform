@bp.route('/<int:id>/amortization', methods=['GET'])
@token_required
def get_amortization(id):
    initialize_db(request.user_id)
    extra_payment = request.args.get('extra_payment', type=float)
    interest_rate = request.args.get('interest_rate', type=float)
    term = request.args.get('term', type=int)
    schedule = get_amortization_schedule(request.user_id, id, extra_payment, interest_rate, term)
    if schedule is not None:
        return jsonify(schedule), 200
    return jsonify({'error': 'Debt not found'}), 404


@bp.route('/consolidated-emi', methods=['GET'])
@token_required
def get_consolidated_emi_route():
    """
    Get the consolidated EMI for all debts of the user.
    
    Returns:
        JSON: The total monthly EMI for all debts.
    """
    initialize_db(request.user_id)
    try:
        total_emi = get_consolidated_emi(request.user_id)
        return jsonify({'consolidated_emi': total_emi}), 200
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@bp.route('/total-debt', methods=['GET'])
@token_required
def get_total_debt_route():
    """
    Get the total outstanding debt for the user.
    
    Returns:
        JSON: The total remaining balance for all debts.
    """
    initialize_db(request.user_id)
    try:
        total_debt = get_total_debt(request.user_id)
        return jsonify({'total_debt': total_debt}), 200
    except Exception as e:
        return jsonify({'error': str(e)}), 500
